<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!-- PostgreSQL Metastore Configuration -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:postgresql://psqlhms:5432/metastore</value>
    <description>JDBC connect string for a JDBC metastore</description>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.postgresql.Driver</value>
    <description>Driver class name for a JDBC metastore</description>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>hive</value>
    <description>username to use against metastore database</description>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>hive</value>
    <description>password to use against metastore database</description>
  </property>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-server:9083</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>
  <property>
     <name>datanucleus.autoCreateSchema</name>
     <value>false</value>
     <description>Creates necessary schema on a startup if one doesn't exist</description>
  </property>

  <!-- WAREHOUSE CONFIGURATION -->
  <!-- DEFAULT: Local Filesystem Warehouse (Simple & Fast) -->
  <property>
     <name>hive.metastore.warehouse.dir</name>
     <value>file:///opt/hive/warehouse</value>
     <description>Local filesystem warehouse - Default for simple setup</description>
  </property>

  <!-- OPTION: Azure Data Lake Storage Gen2 (Uncomment to use) -->
  <!--
  <property>
     <name>hive.metastore.warehouse.dir</name>
     <value>abfss://container@storageaccount.dfs.core.windows.net/hive/warehouse</value>
     <description>Azure ADLS Gen2 warehouse - Replace container and storageaccount with your values</description>
  </property>
  -->

  <!-- Local filesystem additional configuration -->
  <property>
    <name>hive.exec.local.scratchdir</name>
    <value>/tmp/hive</value>
    <description>Local scratch directory for Hive operations</description>
  </property>

  <property>
    <name>hive.downloaded.resources.dir</name>
    <value>/tmp/hive_resources</value>
    <description>Directory for downloaded resources</description>
  </property>

  <!-- AZURE ADLS CONFIGURATION (Uncomment when using Azure) -->
  <!--
  <property>
    <name>hive.exec.scratchdir</name>
    <value>abfss://container@storageaccount.dfs.core.windows.net/tmp/hive</value>
    <description>Azure ADLS scratch directory</description>
  </property>
  
  <property>
    <name>hive.downloaded.resources.dir</name>
    <value>abfss://container@storageaccount.dfs.core.windows.net/tmp/hive_resources</value>
    <description>Azure ADLS resources directory</description>
  </property>
  -->

  <!-- Performance and Compatibility Settings -->
  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
    <description>Bind HiveServer2 to all interfaces</description>
  </property>

  <property>
    <name>hive.server2.thrift.port</name>
    <value>10000</value>
    <description>HiveServer2 Thrift port</description>
  </property>

  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
    <description>Disable metastore event authentication for simplicity</description>
  </property>

  <property>
    <name>hive.stats.autogather</name>
    <value>false</value>
    <description>Disable automatic statistics gathering for performance</description>
  </property>

  <property>
    <name>hive.cbo.enable</name>
    <value>false</value>
    <description>Disable cost-based optimizer for simplicity</description>
  </property>

  <property>
    <name>hive.vectorized.execution.enabled</name>
    <value>false</value>
    <description>Disable vectorized execution for compatibility</description>
  </property>
</configuration>